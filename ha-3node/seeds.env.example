# TEMPLATE for ha-3node/seeds.env (the REAL file is gitignored -- NEVER commit real seeds).
# Copy to seeds.env on the deploy box + fill RANDOM high-entropy seeds (e.g. `openssl rand -hex 32`).
# The deploy renders the manifests (<PEERn_SEED> -> real) + runs genesis from this. Pubkeys are PUBLIC.
PEER1_SEED=<random-hex-32B>
PEER2_SEED=<random-hex-32B>
PEER3_SEED=<random-hex-32B>
# pubkeys = ed25519(sha256(seed)); the dial lists + genesis allow-list reference these (verify with
# `store pubkey --seed <SEED>`). Example (the CURRENT deployed cluster's public keys):
PEER1_PUBKEY=14a05db3d979c59b996c166c28f33ce1a3b8bbb563845690d00f967cf4557438
PEER2_PUBKEY=cd53e0f738cc1c57de5278c3871a9659406450370ceca9013ea4111f54203011
PEER3_PUBKEY=90df938e70ef40b472c84e740a6c499398abc3deedce3235210527ae02107698

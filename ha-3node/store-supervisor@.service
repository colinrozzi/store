# Per-PEER store-node supervisor (systemd template) -- supervisor-dev's piece, staged here so
# the whole HA deploy is one host-reachable directory. Run ONE instance per peer:
#   systemctl enable --now store-supervisor@1 store-supervisor@2 store-supervisor@3
# => a supervisor crash takes down only ITS peer (other 2 keep serving; RF=3 quorum) -- 3
# independent failure domains, and future-proof (move each @N unit to its box unchanged).
[Unit]
Description=store-node supervisor (fleet distribution HA peer %i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/supervisor spawn /etc/store/peer%i-roster.json --logs warn
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
